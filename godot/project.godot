; Engine configuration file.
; Edit through the Godot editor where possible.

config_version=5

[application]

config/name="Sort Master"
config/description="A calm, luminous water-sort puzzle set in a midnight greenhouse."
config/version="0.1.0"
config/icon="res://assets/2d/icons/icon.png"
config/quit_on_go_back=false
run/main_scene="res://scenes/main.tscn"
boot_splash/bg_color=Color(0.0235294, 0.0666667, 0.0862745, 1)
boot_splash/image="res://assets/2d/icons/icon_foreground.png"
boot_splash/fullsize=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
; Desktop window size. The design is 1080x1920, which is taller than most
; monitors, so the exported window used to open with its title bar above the top
; of the screen and no way to close it. These overrides only affect windowed
; desktop builds - Android ignores them and stays fullscreen.
window/size/window_width_override=648
window/size/window_height_override=1152
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
